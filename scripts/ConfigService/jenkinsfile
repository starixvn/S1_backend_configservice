pipeline {
    agent none
    environment {
        env = 'Development'
        registry = '13.213.82.69:8082'
        proj = 'configservice'
    }
    stages {
        stage('Build') {
            agent { node { label 'Build' } }
            steps {
                script {
                    env.version = sh (script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                }
                sh 'sudo docker build -f ./ConfigService/Dockerfile -t ${registry}/${proj}:${version} .'
                sh 'sudo docker login ${registry} -u admin -p 123456'
                sh 'sudo docker push ${registry}/${proj}:${version}'
            }
        }
        stage('Deploy') {
            agent { node { label 'master' } }
            steps {
                sh 'ansible-playbook -i DEV.AWS.yml deploy.docker.yml --extra-vars "host=linux-dev docker_name=dev_configservice ver=configservice:${version} env=Development docker_ports=7242:7242"'
                sh 'ansible-playbook -i DEV.AWS.yml deploy.docker.yml --extra-vars "host=linux-dev docker_name=local_configservice ver=configservice:${version} env=Local docker_ports=7243:7242"'
            }
        }
    }
}
